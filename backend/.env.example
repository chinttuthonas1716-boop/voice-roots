# Voice Roots — Environment Variables
# Copy to .env and fill in your values

# ─── App ──────────────────────────────────────────────────────────────────────
APP_NAME="Voice Roots"
APP_ENV=development
DEBUG=true
SECRET_KEY=your-super-secret-key-change-in-production-at-least-64-chars
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

# ─── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/voice_roots
DATABASE_URL_SYNC=postgresql://postgres:postgres@localhost:5432/voice_roots

# ─── Redis ────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ─── JWT ──────────────────────────────────────────────────────────────────────
JWT_SECRET_KEY=your-jwt-secret-key-change-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30

# ─── Storage ──────────────────────────────────────────────────────────────────
STORAGE_BACKEND=local
LOCAL_STORAGE_PATH=./storage
# For S3 (optional):
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=ap-south-1
# S3_BUCKET=voice-roots-audio

# ─── AI Models ────────────────────────────────────────────────────────────────
AI_PROVIDER=mock
# Options: mock | whisper | huggingface
WHISPER_MODEL_SIZE=base
# HuggingFace models (optional, downloads automatically):
# ASR_MODEL=openai/whisper-base
# LID_MODEL=papluca/xlm-roberta-base-language-detection
# TRANSLATION_MODEL=ai4bharat/indictrans2-indic-en-dist-200M
# EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2

# ─── OpenAI (for RAG fallback) ────────────────────────────────────────────────
OPENAI_API_KEY=sk-your-openai-key-optional

# ─── Celery ───────────────────────────────────────────────────────────────────
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2
