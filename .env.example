# Voice Roots — Web & Application Environment Variables
# Copy this file to .env.local for local Next.js development
# For Render deployment, configure these keys in the Render Service Dashboard under "Environment".

# ─── Environment & Runtime ───────────────────────────────────────────────────
NODE_ENV=production
PORT=3000

# ─── Authentication & Session Security ───────────────────────────────────────
# Secret key used for signing session tokens with HMAC-SHA256 (at least 32 characters)
AUTH_SECRET=voice-roots-indigenous-auth-secret-key-2026

# ─── Speech Recognition (ASR) & AI Inference ──────────────────────────────────
# Hugging Face User Access Token (read permissions) for Whisper & IndicTrans2 models
# Model: openai/whisper-base (Audio to text)
HF_TOKEN=hf_your_huggingface_access_token_here

# Alternative/Fallback Hugging Face token key name:
HUGGINGFACE_API_KEY=

# Optional OpenAI API Key for fallback ASR / Whisper transcription
OPENAI_API_KEY=

# ─── Production URLs & Cross-Origin ──────────────────────────────────────────
NEXT_PUBLIC_APP_URL=https://voice-roots.onrender.com
ALLOWED_ORIGINS=https://voice-roots.onrender.com,http://localhost:3000

