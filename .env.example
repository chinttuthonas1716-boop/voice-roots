# ==============================================================================
# Voice Roots: Rooting Oral Languages in Text with AI
# Production Environment Configuration Template (T1.6)
# ==============================================================================
# Keep secrets out of source control. Copy this template to .env or configure
# environment variables directly in your deployment provider (e.g. Render Dashboard).

# ------------------------------------------------------------------------------
# 1. Backend Server & Runtime Environment
# ------------------------------------------------------------------------------
# Runtime environment ('development' | 'production' | 'staging' | 'test')
VOICE_ROOTS_ENV=production

# Server listening host and port (Render provides $PORT automatically)
PORT=8000
HOST=0.0.0.0

# Secret key for sessions and cryptographic signing (Render generates automatically)
SECRET_KEY=change-this-to-a-64-character-random-hex-string-for-session-signing

# CORS Allowed Origins: comma-separated list of permitted origins
# In production on Render: https://voice-roots.onrender.com
CORS_ORIGINS=https://voice-roots.onrender.com,http://localhost:3000

# Legacy CORS configuration key (for backwards compatibility)
VOICE_ROOTS_ALLOWED_ORIGINS=https://voice-roots.onrender.com,http://localhost:3000

# ------------------------------------------------------------------------------
# 2. Database & Persistence (PostgreSQL & SQLite Fallback)
# ------------------------------------------------------------------------------
# Primary PostgreSQL Database URL (Render non-expiring Postgres instance)
# Format: postgresql://username:password@hostname:5432/database_name
DATABASE_URL=postgresql://voice_user:voice_secure_password@dpg-xxxxx-a.oregon-postgres.render.com/voice_roots_prod

# Offline/Local SQLite database path (used when DATABASE_URL is unset)
VOICE_ROOTS_DB_PATH=backend/voice_roots.db

# Atomic backup snapshots directory
VOICE_ROOTS_BACKUP_DIR=backend/backups

# Persistent ChromaDB vector store directory
VOICE_ROOTS_CHROMA_DIR=backend/chroma_db

# ------------------------------------------------------------------------------
# 3. Object Storage: Cloudflare R2 / Local Storage
# ------------------------------------------------------------------------------
# Storage provider backend: 'r2' (production cloud) | 'local' (offline zero-cost)
STORAGE_BACKEND=r2

# Cloudflare R2 credentials (private S3-compatible bucket, zero egress fees)
R2_ENDPOINT_URL=https://<cloudflare_account_id>.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET=voice-roots-masters

# Local storage fallback directory
VOICE_ROOTS_STORAGE_DIR=backend/storage

# ------------------------------------------------------------------------------
# 4. Security, Authentication & Rate Limiting
# ------------------------------------------------------------------------------
# JWT Session Signing Secret Key (Must be at least 32 characters in production)
VOICE_ROOTS_JWT_SECRET=change-this-to-a-64-character-random-hex-string-for-jwt-signing
VOICE_ROOTS_JWT_EXPIRATION_HOURS=24

# Sliding-window rate limiting quotas (requests per minute per client IP)
API_RATE_LIMIT_PER_MINUTE=120
AUTH_RATE_LIMIT_PER_MINUTE=30
UPLOAD_RATE_LIMIT_PER_MINUTE=40

# Secret administrator key for protected management endpoints
VOICE_ROOTS_ADMIN_KEY=change-this-to-a-secure-random-token-in-production

# First-boot initial administrator password (if unset, a random password is generated and logged)
INITIAL_ADMIN_EMAIL=admin@voiceroots.ai
INITIAL_ADMIN_PASSWORD=change-this-to-a-strong-random-password-for-production-admin

# Sentry DSN for error telemetry (optional; PII sanitized)
SENTRY_DSN=

# Multi-user administrator identities (name:token pairs)
VOICE_ROOTS_ADMIN_USERS=pi_linguist_1:secure-token-alpha,elder_council_head:secure-token-beta

# ------------------------------------------------------------------------------
# 5. Speech Recognition & Translation Engines
# ------------------------------------------------------------------------------
# Speech recognition provider: 'whisper-local' (offline zero-cost default)
# Options: whisper-local | whisper-api | gemini-speech | mock
VOICE_ROOTS_TRANSCRIPTION_PROVIDER=whisper-local
VOICE_ROOTS_WHISPER_MODEL_SIZE=base

# Translation provider: 'offline-rule' | 'indictrans2'
VOICE_ROOTS_TRANSLATION_PROVIDER=offline-rule

# Optional hosted IndicTrans2 endpoint URL (Phase 2 T2.1)
INDICTRANS2_ENDPOINT_URL=

# ------------------------------------------------------------------------------
# 6. Frontend Configuration (Next.js 14 App Router)
# ------------------------------------------------------------------------------
# Build-time API Base URL for next.config.mjs rewrites (/api/v1/* -> backend)
# Must be configured in frontend environment before build.
API_BASE_URL=https://voice-roots-api.onrender.com
NODE_ENV=production
