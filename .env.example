# ==============================================================================
# Voice Roots: Rooting Oral Languages in Text with AI
# Environment Configuration Template
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Backend Server & Environment
# ------------------------------------------------------------------------------
# Runtime environment ('development' | 'production' | 'staging')
VOICE_ROOTS_ENV=production

# Server listening host and port
PORT=8000
HOST=0.0.0.0

# CORS Allowed Origins (comma-separated list of origins permitted to reach the API)
# In production, replace with your custom frontend domain or Vercel URL
VOICE_ROOTS_ALLOWED_ORIGINS=https://your-app-domain.vercel.app,http://localhost:5173,http://127.0.0.1:5173

# Secret administrator key for protected endpoints (resource re-indexing / dataset ingestion)
# Required when invoking POST /api/v1/resources/ingest or /api/v1/resources/reindex
VOICE_ROOTS_ADMIN_KEY=change-this-to-a-secure-random-token-in-production

# Multi-user administrator identities (JSON or comma-separated name:token pairs) (PR-03)
# Allows distinct attribution for principal investigators, lead linguists, and elder council heads
VOICE_ROOTS_ADMIN_USERS=pi_linguist_1:secure-token-alpha,elder_council_head:secure-token-beta

# JWT Session Signing Secret Key (Must be at least 32 characters in production)
VOICE_ROOTS_JWT_SECRET=change-this-to-a-64-character-random-hex-string-for-jwt-signing
VOICE_ROOTS_JWT_EXPIRATION_HOURS=24

# ------------------------------------------------------------------------------
# 2. Storage & Persistence (Mount to Persistent Volume in Container Deployments)
# ------------------------------------------------------------------------------
# Path to SQLite database file
VOICE_ROOTS_DB_PATH=backend/voice_roots.db

# Path to directory for immutable master audio recordings
VOICE_ROOTS_STORAGE_DIR=backend/storage

# Path to directory for atomic SQLite database backups
VOICE_ROOTS_BACKUP_DIR=backend/backups

# Path to persistent ChromaDB vector store
VOICE_ROOTS_CHROMA_DIR=backend/chroma_db

# ------------------------------------------------------------------------------
# 3. Speech Recognition / Transcription Engine
# ------------------------------------------------------------------------------
# Speech recognition provider: 'whisper-local' (offline zero-cost default)
# Options: whisper-local | whisper-api | gemini-speech | mock
VOICE_ROOTS_TRANSCRIPTION_PROVIDER=whisper-local

# Whisper model size for local inference: 'tiny' | 'base' | 'small' | 'medium' | 'large-v3'
# 'base' recommended for balanced CPU/GPU performance and oral language support
VOICE_ROOTS_WHISPER_MODEL_SIZE=base

# ------------------------------------------------------------------------------
# 4. Universal Translation & Linguistic Capabilities
# ------------------------------------------------------------------------------
# Translation provider: 'offline-rule' (default zero-cost offline adapter)
# Options: offline-rule | indictrans2 | nllb | gemini-translate
VOICE_ROOTS_TRANSLATION_PROVIDER=offline-rule

# ------------------------------------------------------------------------------
# 5. Frontend Client Configuration (Vite)
# ------------------------------------------------------------------------------
# Production backend API Base URL. Leave empty if serving from same origin/reverse proxy.
# In decoupled deployments (e.g., Vercel + Render), set to your backend service URL.
VITE_API_URL=https://your-backend-api.onrender.com

