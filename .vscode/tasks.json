{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "🌐 Web: Start Next.js Dev",
      "type": "shell",
      "command": "npm run dev",
      "options": {
        "cwd": "${workspaceFolder}/web"
      },
      "isBackground": true,
      "problemMatcher": []
    },
    {
      "label": "🌐 Web: Build Next.js Production",
      "type": "shell",
      "command": "npm run build",
      "options": {
        "cwd": "${workspaceFolder}/web"
      },
      "problemMatcher": ["$tsc"]
    },
    {
      "label": "⚙️ Backend: Start FastAPI",
      "type": "shell",
      "command": "python3 -m uvicorn app.main:app --reload --port 8000",
      "options": {
        "cwd": "${workspaceFolder}/backend"
      },
      "isBackground": true,
      "problemMatcher": []
    },
    {
      "label": "📱 Mobile: Start Expo",
      "type": "shell",
      "command": "npm run start",
      "options": {
        "cwd": "${workspaceFolder}/mobile"
      },
      "isBackground": true,
      "problemMatcher": []
    },
    {
      "label": "🦋 Flutter: Run App",
      "type": "shell",
      "command": "flutter run",
      "options": {
        "cwd": "${workspaceFolder}/flutter_app"
      },
      "problemMatcher": []
    },
    {
      "label": "🧪 Test: Run Audit Suite",
      "type": "shell",
      "command": "python3 scripts/audit_functionality.py",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    }
  ]
}
